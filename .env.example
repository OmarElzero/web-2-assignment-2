# Fresh setup: copy this file to .env and fill APP_KEY + TMDB_API_KEY (see php artisan key:generate).
# Private team: run ./setup-dev.sh instead — it copies env.team (shared keys) for you.

APP_NAME=MovieReview
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Leave DB_DATABASE unset to use database/database.sqlite via Laravel's database_path()

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local

TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
